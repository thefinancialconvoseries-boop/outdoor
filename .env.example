# VITE_WEB3FORMS_ACCESS_KEY: Routes Hub Week registration form submissions to an inbox.
# Get a free key by entering your inbox email at https://web3forms.com (no account needed,
# the key arrives by email in under a minute). This key is safe to expose client-side —
# it only authorizes submissions to the inbox it was issued for, nothing more.
VITE_WEB3FORMS_ACCESS_KEY="MY_WEB3FORMS_ACCESS_KEY"
